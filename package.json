{
  "name": "prod-ready-frontend-boilerplate",
  "version": "0.0.0",
  "private": true,
  "packageManager": "npm@12.1.0",
  "engines": {
    "node": "24.x",
    "npm": "12.x"
  },
  "volta": {
    "node": "24.21.0",
    "npm": "12.1.0"
  },
  "scripts": {
    "generate-code": "tsx --tsconfig tsconfig.node.json scripts/generate-code.ts",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "prepare": "husky",
    "lint": "run-p -l lint:*",
    "lint:code": "eslint . --max-warnings 0 --cache",
    "lint:types": "tsc --noEmit --incremental && tsc --project tsconfig.node.json --noEmit --incremental && tsc --project tsconfig.vite.json --noEmit --incremental",
    "lint:style": "stylelint 'src/**/*.{css,ts,tsx}' --allow-empty-input",
    "fix": "run-p -l fix:*",
    "fix:code": "npm run lint:code -- --fix",
    "fix:types": "npm run lint:types",
    "fix:style": "npm run lint:style -- --fix",
    "lint:knip": "knip",
    "test": "vitest run",
    "test:watch": "vitest",
    "generate-page": "tsx --tsconfig tsconfig.node.json scripts/generate-page.ts",
    "generate-hook": "tsx --tsconfig tsconfig.node.json scripts/generate-hook.ts",
    "generate-util": "tsx --tsconfig tsconfig.node.json scripts/generate-util.ts",
    "generate-component": "tsx --tsconfig tsconfig.node.json scripts/generate-component.ts",
    "generate-store": "tsx --tsconfig tsconfig.node.json scripts/generate-store.ts",
    "generate-context": "tsx --tsconfig tsconfig.node.json scripts/generate-context.ts",
    "generate-query": "tsx --tsconfig tsconfig.node.json scripts/generate-query.ts",
    "generate-fragment": "tsx --tsconfig tsconfig.node.json scripts/generate-fragment.ts",
    "graphql-extract": "tsx --tsconfig tsconfig.node.json scripts/graphql-extract.ts",
    "test:scaffolders": "tsx --tsconfig tsconfig.node.json --test scripts/scaffold.spec.ts",
    "check-import-from-src": "tsx --tsconfig tsconfig.node.json scripts/check-import-from-src.ts",
    "check-apollo-hooks": "tsx --tsconfig tsconfig.node.json scripts/check-apollo-hooks.ts",
    "check-graphql-hook-naming": "tsx --tsconfig tsconfig.node.json scripts/check-graphql-hook-naming.ts",
    "check-changed-shared-coverage": "tsx --tsconfig tsconfig.node.json scripts/check-changed-shared-coverage.ts",
    "check-used-icons": "tsx --tsconfig tsconfig.node.json scripts/check-used-icons.ts",
    "check-engines-versions": "tsx --tsconfig tsconfig.node.json scripts/check-engines-versions.ts",
    "check-problem-translation-keys": "tsx --tsconfig tsconfig.node.json scripts/check-problem-translation-keys.ts",
    "lint:guards": "run-s check-*",
    "test:guards": "tsx --tsconfig tsconfig.node.json --test scripts/guards.spec.ts",
    "graph-generate": "node scripts/graph-build.mjs generate",
    "graph": "node scripts/graph-build.mjs query",
    "test:graphs": "tsx --tsconfig tsconfig.node.json --test scripts/graphs.spec.ts",
    "test:hooks": "node --test scripts/hooks.spec.mjs",
    "docs:drift": "node scripts/docs/cli.mjs drift",
    "test:agents": "node --test scripts/agents.spec.mjs",
    "docs:status": "node scripts/docs/cli.mjs status",
    "docs:context": "node scripts/docs/cli.mjs context",
    "docs:validate": "node scripts/docs/cli.mjs validate",
    "docs:sync": "node scripts/docs/cli.mjs sync",
    "docs:sync-guides": "node scripts/docs/cli.mjs sync-guides",
    "docs:backfill": "node scripts/docs/cli.mjs backfill",
    "docs:backfill-one": "node scripts/docs/cli.mjs backfill-one",
    "docs:drift:strict": "node scripts/docs/cli.mjs drift --sweep --strict",
    "test:docs": "node --test scripts/docs.spec.mjs",
    "test:parity": "node --test scripts/parity.spec.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@graphql-codegen/cli": "^7.4.2",
    "@graphql-codegen/introspection": "^6.1.0",
    "@graphql-codegen/schema-ast": "^6.1.0",
    "@graphql-codegen/typed-document-node": "^7.1.0",
    "@graphql-codegen/typescript": "^6.1.0",
    "@graphql-codegen/typescript-operations": "^6.1.7",
    "@graphql-codegen/typescript-resolvers": "^6.1.0",
    "@graphql-eslint/eslint-plugin": "^4.4.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@testing-library/react": "^16.3.3",
    "@trivago/prettier-plugin-sort-imports": "^6.0.2",
    "@types/node": "^24.0.0",
    "@types/prompts": "^2.4.9",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/semver": "^7.8.0",
    "@typescript-eslint/eslint-plugin": "^8.70.1",
    "@typescript-eslint/parser": "^8.70.1",
    "@vitejs/plugin-legacy": "^8.2.3",
    "@vitejs/plugin-react-swc": "^4.3.3",
    "ejs": "^6.0.1",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "graphql-config": "^5.1.7",
    "husky": "^9.1.7",
    "jsdom": "^30.1.1",
    "knip": "^5.0.0",
    "npm-run-all2": "^9.0.3",
    "postcss-styled-syntax": "^0.7.2",
    "prettier": "^3.9.9",
    "prompts": "^2.4.2",
    "semver": "^7.8.5",
    "stylelint": "^17.15.0",
    "stylelint-config-recommended": "^18.0.0",
    "stylelint-order": "^8.1.1",
    "terser": "^5.51.2",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vite": "^8.3.0",
    "vite-plugin-compression2": "^2.5.3",
    "vite-plugin-ejs": "^2.0.0",
    "vite-plugin-minify": "^3.0.0",
    "vite-plugin-svgr": "^5.2.0",
    "vitest": "^5.0.1"
  },
  "dependencies": {
    "@apollo/client": "^4.3.1",
    "@graphql-typed-document-node/core": "^3.2.0",
    "graphql": "^16.14.2",
    "i18next": "^26.4.2",
    "immer": "^11.1.18",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-i18next": "^17.0.15",
    "rxjs": "^7.8.2",
    "use-sync-external-store": "^1.7.0",
    "zustand": "^5.0.15"
  }
}
